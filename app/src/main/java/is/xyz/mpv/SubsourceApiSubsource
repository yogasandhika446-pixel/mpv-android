package is.xyz.mpv

import okhttp3.ResponseBody
import retrofit2.Response
import retrofit2.Retrofit
import retrofit2.converter.gson.GsonConverterFactory
import retrofit2.http.GET
import retrofit2.http.Query
import retrofit2.http.Url

interface SubsourceApi {
    @GET("api/v1/subtitles/search") // Sesuaikan endpoint API Subsource yang digunakan
    suspend fun searchSubtitles(
        @Query("query") query: String,
        @Query("lang") lang: String = "en"
    ): Response<List<SubtitleItem>>

    @GET
    suspend fun downloadFile(@Url fileUrl: String): Response<ResponseBody>

    companion object {
        private const val BASE_URL = "https://api.subsource.dev/" // Contoh Base URL API Subsource

        fun create(): SubsourceApi {
            val retrofit = Retrofit.Builder()
                .baseUrl(BASE_URL)
                .addConverterFactory(GsonConverterFactory.create())
                .build()
            return retrofit.create(SubsourceApi::class.java)
        }
    }
}
